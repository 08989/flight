export type AppTheme = 'midnight' | 'space' | 'ocean' | 'neon' | 'sunset';

export interface ThemeConfig {
  id: AppTheme;
  name: string;
  bgClass: string;
  cardClass: string;
  borderClass: string;
  accentClass: string;
  gradientFrom: string;
  gradientTo: string;
  // Dynamic architectural changes
  layout: 'corporate' | 'cyberpunk' | 'minimalist' | 'futuristic' | 'dashboard';
  fontFamily: string;
}

